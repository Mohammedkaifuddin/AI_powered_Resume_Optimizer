generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  resumes   Resume[]
}

model Resume {
  id              String @id @default(cuid())
  UserId          String
  fileName        String
  fileType        String
  extractedText   String
  createdAt       DateTime @default(now())

  User User @relation(fields: [UserId], references: [id], onDelete: Cascade)
}